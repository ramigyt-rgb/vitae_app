# Copiá este archivo como .streamlit/secrets.toml y completá los valores.
# En Streamlit Cloud: Settings → Secrets, pegando este mismo contenido.
# NUNCA subas secrets.toml al repositorio.

# ID de la planilla de Google Sheets que funciona como base de datos
GOOGLE_SHEET_ID = "id-de-la-planilla"

# JSON completo de la cuenta de servicio de Google (con acceso de editor a la planilla)
GOOGLE_SERVICE_ACCOUNT_JSON = """
{
  "type": "service_account",
  "project_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@....iam.gserviceaccount.com"
}
"""

